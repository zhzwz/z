{
  "name": "@zhzwz/eslint-config",
  "type": "module",
  "version": "0.1.0",
  "description": "Personal ESLint flat config built on @antfu/eslint-config",
  "author": "zhzwz",
  "homepage": "https://github.com/zhzwz/z/tree/main/packages/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhzwz/z.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/zhzwz/z/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules"
  },
  "peerDependencies": {
    "eslint": "^9.10.0 || ^10.0.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cspell/eslint-plugin": "^10.0.1",
    "@unocss/eslint-plugin": "^66.7.4",
    "astro-eslint-parser": "^3.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.7.0",
    "prettier-plugin-astro": "^0.14.1"
  },
  "devDependencies": {
    "@eslint/core": "^1.2.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/types": "^8.62.1",
    "eslint": "^10.6.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
