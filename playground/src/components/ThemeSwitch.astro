---
import { choices } from '../theme.ts'
---

<div aria-label="主题" class="theme-switch" role="group">
  {choices.map((choice) => (
    <button class="theme-switch__button" data-theme-choice={choice.value} type="button">
      {choice.label}
    </button>
  ))}
</div>

<script>
  import type { ThemeChoice } from '../theme.ts'
  import { currentChoice, isThemeChoice, onThemeChange, setChoice } from '../theme.ts'

  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-switch__button')

  function markCurrent(choice: ThemeChoice) {
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice))
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const { themeChoice } = button.dataset
      if (isThemeChoice(themeChoice)) {
        setChoice(themeChoice)
      }
    })
  }

  markCurrent(currentChoice())
  onThemeChange(markCurrent)
</script>

<style>
  .theme-switch {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .theme-switch__button {
    height: 26px;
    padding: 0 8px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--text-soft);
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
  }

  .theme-switch__button:hover {
    color: var(--text);
  }

  .theme-switch__button[aria-pressed='true'] {
    background: var(--bg-soft);
    color: var(--text);
  }

  .theme-switch__button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
</style>
