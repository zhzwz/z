{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2024"
    ],
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "tsdown.config.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "test/**/*.ts",
    "packages/eslint-config/env.d.ts"
  ],
  "exclude": [
    "test/consumer"
  ]
}
