{
  "name": "@zhzwz/z",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@12.4.1",
  "description": "Personal toolkit",
  "author": "zhzwz",
  "homepage": "https://github.com/zhzwz/z#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhzwz/z.git"
  },
  "bugs": {
    "url": "https://github.com/zhzwz/z/issues"
  },
  "keywords": [
    "vue",
    "components",
    "naive-ui",
    "eslint-config"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./accent": {
      "types": "./dist/components/accent.d.ts",
      "default": "./dist/components/accent.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./eslint-config": {
      "types": "./dist/eslint-config.d.ts",
      "default": "./dist/eslint-config.js"
    },
    "./resolver": {
      "types": "./dist/components/resolver.d.ts",
      "default": "./dist/components/resolver.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm build:deps && tsdown",
    "build:deps": "pnpm --filter @zhzwz/eslint-config build",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test && pnpm build && vitest run",
    "test:coverage": "pnpm -r --if-present test && pnpm build && vitest run --coverage",
    "typecheck": "pnpm build:deps && vue-tsc -p . && tsc -p tsconfig.node.json && pnpm -r --if-present typecheck",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "date-fns": "^4.0.0",
    "eslint": "^9.10.0 || ^10.0.0",
    "naive-ui": "^2.45.0",
    "unplugin-vue-components": "^32.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@iconify/vue": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "naive-ui": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@zhzwz/eslint-config": "workspace:^"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.5",
    "@tsdown/css": "^0.23.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "^2.5.1",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "naive-ui": "^2.45.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  }
}
